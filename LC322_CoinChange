class Solution:
    def coinChange(self, coins: List[int], amount: int) -> int:
        def bt(coins: int, remaining_amount: int, index: int):
            """ Returns number of coins for the give amount starting at i or -1 if not found
            """
            if remaining_amount == 0:
                return coins
            
            if remaining_amount < 0 or index == len(coins):
                return -1
            
            # can we get the remaining amount if we use the current coin

            coins_or_failure =  bt(coins+1, remaining_amount-coins[index], index+1)

            if coins_or_failure >=0:
                return coins_or_failure
            
        
        return bt(coins, remaning_amount, index+1)
        
