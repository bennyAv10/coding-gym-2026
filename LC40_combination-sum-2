"""
initialize subtargets to a list with empty group. 
at each time you clone each subtarget with another grooup that also containing the new element.
each subtarget is paired with its running sum. if with the new item the sum is higher don't clone. if sum is target add it to targets sorted.
otherwise, clone.
targets is a set so it filter out duplicate ones
Time: O(2^30) even if all nums are 1 and target is 30 (the max), max length of a group is target as min num is 1
Space: N
"""
class Solution:
    def combinationSum2(self, candidates: List[int], target: int) -> List[List[int]]:
        subtargets = [([], 0)]
        targets=set()

        for candidate in candidates:
            if candidate > target:
                continue
            elif candidate == target:
                targets.add((candidate,))
            i=0
            new_subtargets = []
            while i<len(subtargets):
                subtarget, sum = subtargets[i]
                new_subtarget = subtarget.copy()
                if sum + candidate > target:
                    i+=1
                    continue
                elif sum+candidate == target:
                    new_subtarget.append(candidate)
                    new_subtarget.sort()
                    targets.add(tuple(new_subtarget))
                    i+=1
                else:                    
                    new_subtarget.append(candidate)
                    new_subtargets.append((new_subtarget, sum+candidate))
                    i+=1
            subtargets.extend(new_subtargets)

        return [[element for element in elements] for elements in targets]

